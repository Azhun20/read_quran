{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Mode",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=ENVIRONMENT=development"
            ]
        },
        {
            "name": "Release Mode",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart"
        },
        {
            "name": "Profile Mode",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main.dart"
        },
        {
            "name": "Release Mode (Android)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart",
            "deviceId": "android"
        },
        {
            "name": "Release Mode (iOS)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart",
            "deviceId": "ios"
        },
        {
            "name": "Debug Mode (Portrait Only)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=ENVIRONMENT=development"
            ]
        }
    ]
}
